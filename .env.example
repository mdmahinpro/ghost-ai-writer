# Ghost AI Writer — environment template
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- Database (better-auth tables). Unset = local PGLite fallback. ---
DATABASE_URL=

# --- Workspace encryption key for app state at rest (base64/hex) ---
GHOST_GROK_ENC_KEY=

# --- Where server-side app state is written (defaults to ./.data) ---
APP_DATA_DIR=

# --- Ghost connector (gate / deployed environment) ---
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
GROK_GATE_ORIGIN=
GROK_PROJECT_ID=

# --- Client-visible auth + hostname ---
VITE_AUTH_ENABLED=true
VITE_PUBLIC_HOSTNAME=

# --- Ghost Admin credentials used by the live-inspection scripts ---
GHOST_EMAIL=
GHOST_PASSWORD=
