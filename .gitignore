# --- Secrets: never commit real credentials ---
.env
.env.*
!.env.example

# Local app state + workspace encryption key (.data/enc.key)
.data/
# The key file is written beside the database, so it can land in the repo root
# when DATABASE_URL is a bare filename.
enc.key

# Captured live Ghost session cookies
knowledge-base/cookies.json

# --- Logs, OS and editor junk ---
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Build artifacts and vendored deps: never commit ---
node_modules/
.vercel/
.output/
dist/
public/media/
data/

# Rust build output
backend/target/

# Local SQLite databases created by running the API (DATABASE_URL default
# is sqlite:gaw.db?mode=rwc, so a local run drops one in backend/).
gaw.db
gaw.db-shm
gaw.db-wal
*.sqlite
*.sqlite3

# deploy/build artifacts (regenerated per host)
.output/
.vercel/
